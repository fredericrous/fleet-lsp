{
  "name": "fleet-lsp",
  "version": "0.4.0",
  "description": "Pinned, ready language servers: each server verified against the repository's pin, every query held until the server has loaded. Replaces the official gopls-lsp, rust-analyzer-lsp, typescript-lsp and pyright-lsp plugins; turn those off.",
  "author": {
    "name": "Frederic Rousseau"
  },
  "homepage": "https://github.com/fredericrous/fleet-lsp",
  "repository": "https://github.com/fredericrous/fleet-lsp",
  "license": "MIT",
  "keywords": ["lsp", "rust-analyzer", "gopls", "pyright", "typescript"],
  "lspServers": {
    "rust": {
      "command": "fleet-lsp",
      "args": ["serve", "rust", "--min-version", "0.4.0"],
      "extensionToLanguage": { ".rs": "rust" },
      "requestTimeout": 400000,
      "maxRestarts": 2
    },
    "go": {
      "command": "fleet-lsp",
      "args": ["serve", "go", "--min-version", "0.4.0"],
      "extensionToLanguage": { ".go": "go" },
      "startupTimeout": 210000,
      "requestTimeout": 400000,
      "maxRestarts": 2
    },
    "python": {
      "command": "fleet-lsp",
      "args": ["serve", "python", "--min-version", "0.4.0"],
      "extensionToLanguage": { ".py": "python", ".pyi": "python" },
      "requestTimeout": 400000,
      "maxRestarts": 2
    },
    "typescript": {
      "command": "fleet-lsp",
      "args": ["serve", "typescript", "--min-version", "0.4.0"],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".mjs": "javascript",
        ".cjs": "javascript"
      },
      "requestTimeout": 400000,
      "maxRestarts": 2
    }
  }
}
